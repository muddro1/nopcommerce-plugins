@model LogModel
@inject Nop.Services.Helpers.IDateTimeHelper DateTimeHelper
@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName(XpsShipDefaults.MenuSales);
    ViewBag.PageTitle = "XPS Ship";
    var warnings = Model.Endpoint == XpsShipDefaults.EndpointWarning;
    var endpoints = new[]
    {
        XpsShipDefaults.EndpointListOrders, XpsShipDefaults.EndpointGetOrder, XpsShipDefaults.EndpointUpdateOrder,
        XpsShipDefaults.EndpointVoid, XpsShipDefaults.EndpointWarning
    };
}

<div class="content-header clearfix">
    <h1 class="float-left">XPS Ship <small>@(warnings ? "warnings" : "webhook log")</small></h1>
</div>

<section class="content">
    <div class="container-fluid">
        <partial name="~/Plugins/Misc.XpsShip/Views/Admin/_Nav.cshtml" model="@(warnings ? "Warnings" : "Log")" />

        <div class="card card-default">
            <div class="card-body">
                @if (warnings)
                {
                    <p class="text-muted small">Lines sent to XPS without a SKU or a weight, and quantities XPS posted above what was left to ship. Fix the product in the catalog; each warning is logged once per order every @XpsShipDefaults.WarningsDays days.</p>
                }
                <form method="get" asp-action="Log" class="form-inline mb-3">
                    <select name="endpoint" class="form-control mr-2">
                        <option value="">All</option>
                        @foreach (var endpoint in endpoints)
                        {
                            <option value="@endpoint" selected="@(Model.Endpoint == endpoint)">@endpoint</option>
                        }
                    </select>
                    <input type="text" name="orderNumber" value="@Model.OrderNumber" class="form-control mr-2" placeholder="Order #" />
                    <div class="form-check mr-2">
                        <input class="form-check-input" type="checkbox" id="errorsOnly" name="errorsOnly" value="true" @(Model.ErrorsOnly ? "checked" : "") />
                        <label class="form-check-label" for="errorsOnly">Errors only</label>
                    </div>
                    <button type="submit" class="btn btn-default"><i class="fas fa-search"></i> Search</button>
                </form>

                @if (!Model.Rows.Any())
                {
                    <p class="text-muted">Nothing logged.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>When</th><th>Endpoint</th><th>Status</th><th>Order</th><th>IP</th><th>Result</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr class="@(row.HttpStatus >= 400 ? "table-danger" : row.Endpoint == XpsShipDefaults.EndpointWarning ? "table-warning" : "")">
                                    <td class="text-nowrap">@(await DateTimeHelper.ConvertToUserTimeAsync(row.CreatedOnUtc, DateTimeKind.Utc))</td>
                                    <td>@row.Endpoint</td>
                                    <td>@(row.HttpStatus == 0 ? "" : row.HttpStatus.ToString())</td>
                                    <td>@row.CustomOrderNumber</td>
                                    <td>@row.RemoteIp</td>
                                    <td>
                                        @row.ResponseSummary
                                        @if (!string.IsNullOrEmpty(row.Message))
                                        {
                                            <div>@row.Message</div>
                                        }
                                        @if (!string.IsNullOrEmpty(row.RequestBody))
                                        {
                                            <details><summary class="small">Request</summary><pre class="small mb-0">@row.RequestBody</pre></details>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="~/Plugins/Misc.XpsShip/Views/Admin/_Pager.cshtml" model="Model" />
                }
            </div>
        </div>
    </div>
</section>
