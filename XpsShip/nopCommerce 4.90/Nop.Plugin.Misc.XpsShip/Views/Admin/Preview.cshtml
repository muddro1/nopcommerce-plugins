@model PreviewModel
@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName(XpsShipDefaults.MenuSales);
    ViewBag.PageTitle = "XPS Ship";
}

<div class="content-header clearfix">
    <h1 class="float-left">XPS Ship <small>preview List Orders</small></h1>
</div>

<section class="content">
    <div class="container-fluid">
        <partial name="~/Plugins/Misc.XpsShip/Views/Admin/_Nav.cshtml" model="@("Preview")" />

        <div class="card card-default">
            <div class="card-header"><h3 class="card-title">Left out (@Model.Excluded.Count)</h3></div>
            <div class="card-body">
                @if (!Model.Excluded.Any())
                {
                    <p class="text-muted">Every open order is in the list.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered table-striped">
                        <thead><tr><th>Order</th><th>Why</th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Excluded)
                            {
                                <tr>
                                    <td><a asp-controller="Order" asp-action="Edit" asp-route-id="@row.OrderId">@row.OrderNumber</a></td>
                                    <td>@row.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header"><h3 class="card-title">Sent to XPS (@Model.OrderCount)</h3></div>
            <div class="card-body">
                <p class="text-muted small">Exactly what List Orders returns right now. Running the preview also puts "do not ship" orders on hold, as a real poll would.</p>
                <pre style="max-height: 70vh; overflow: auto; white-space: pre-wrap;">@Model.Json</pre>
            </div>
        </div>
    </div>
</section>
