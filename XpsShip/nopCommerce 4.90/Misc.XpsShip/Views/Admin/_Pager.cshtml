@model PagedListModel
@{
    // Keep the current filters on the page links
    var query = Context.Request.Query.Where(q => q.Key != "page").ToDictionary(q => q.Key, q => q.Value.ToString());
    string Link(int page)
    {
        var values = new Dictionary<string, string>(query) { ["page"] = page.ToString() };
        return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(values!);
    }
}
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@Model.TotalCount · @(Model.PageIndex + 1) / @Model.TotalPages</span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.PageIndex == 0 ? "disabled" : "")"><a class="page-link" href="@Link(Model.PageIndex)">&laquo;</a></li>
            <li class="page-item @(Model.PageIndex + 1 >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.PageIndex + 2)">&raquo;</a></li>
        </ul>
    </div>
}
