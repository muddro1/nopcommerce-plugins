@model FlagsModel
@inject Nop.Services.Helpers.IDateTimeHelper DateTimeHelper
@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName(XpsShipDefaults.MenuSales);
    ViewBag.PageTitle = "XPS Ship";
}

<div class="content-header clearfix">
    <h1 class="float-left">XPS Ship <small>hold &amp; release</small></h1>
</div>

<section class="content">
    <div class="container-fluid">
        <partial name="~/Plugins/Misc.XpsShip/Views/Admin/_Nav.cshtml" model="@("Flags")" />

        @if (Model.CanEdit)
        {
            <div class="card card-default">
                <div class="card-body">
                    <form asp-action="AddFlag" method="post" class="form-inline">
                        <input type="text" name="orderNumber" class="form-control mr-2 mb-2" placeholder="Order #" required />
                        <select name="flag" class="form-control mr-2 mb-2">
                            <option value="@OrderFlags.Hold">Hold (keep out of XPS)</option>
                            <option value="@OrderFlags.ReleaseExchange">Release exchange order</option>
                        </select>
                        <input type="text" name="reason" class="form-control mr-2 mb-2" style="min-width: 320px" placeholder="Reason" />
                        <button type="submit" class="btn btn-primary mb-2">Add</button>
                    </form>
                    <small class="text-muted">
                        Held orders stay out of List Orders until removed here. Exchange orders (SKU ending in the exchange suffix) stay out until released.
                        Orders whose special instruction says "do not ship" are held automatically the first time they're seen.
                    </small>
                </div>
            </div>
        }

        <div class="card card-default">
            <div class="card-body">
                <form method="get" asp-action="Flags" class="form-inline mb-3">
                    <select name="flag" class="form-control mr-2">
                        <option value="">All</option>
                        <option value="@OrderFlags.Hold" selected="@(Model.Flag == OrderFlags.Hold)">Held</option>
                        <option value="@OrderFlags.ReleaseExchange" selected="@(Model.Flag == OrderFlags.ReleaseExchange)">Exchange released</option>
                        <option value="@OrderFlags.HoldCleared" selected="@(Model.Flag == OrderFlags.HoldCleared)">Taken off hold</option>
                    </select>
                    <input type="text" name="orderNumber" value="@Model.OrderNumber" class="form-control mr-2" placeholder="Order #" />
                    <button type="submit" class="btn btn-default"><i class="fas fa-search"></i> Search</button>
                </form>

                @if (!Model.Rows.Any())
                {
                    <p class="text-muted">Nothing here.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered table-striped">
                        <thead><tr><th>Order</th><th>Entry</th><th>Reason</th><th>By</th><th>When</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@row.CustomOrderNumber</td>
                                    <td>@(row.Flag == OrderFlags.Hold ? "Held" : row.Flag == OrderFlags.ReleaseExchange ? "Exchange released" : "Taken off hold")</td>
                                    <td>@row.Reason</td>
                                    <td>@row.CreatedBy</td>
                                    <td>@(await DateTimeHelper.ConvertToUserTimeAsync(row.CreatedOnUtc, DateTimeKind.Utc))</td>
                                    <td>
                                        @if (Model.CanEdit && row.Flag != OrderFlags.HoldCleared)
                                        {
                                            <form asp-action="RemoveFlag" asp-route-id="@row.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(row.Flag == OrderFlags.Hold ? "Take off hold" : "Undo release")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="~/Plugins/Misc.XpsShip/Views/Admin/_Pager.cshtml" model="Model" />
                }
            </div>
        </div>
    </div>
</section>
